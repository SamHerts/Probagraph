{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Probagraph",
  "version": "../package.json",
  "identifier": "io.github.samherts.probagraph",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Probagraph", "width": 1280, "height": 760, "minWidth": 800, "minHeight": 450 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Probability tree builder",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "signingIdentity": "-" }
  }
}
